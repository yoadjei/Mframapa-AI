# ──────────────────────────────────────────────────────────────
# Mframapa v2.0 — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Copernicus Climate Data Store (ERA5) ───────────────────────
# Register at https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-cds-uid-and-api-key-here

# ── Copernicus Data Space Ecosystem (Sentinel-5P TROPOMI) ──────
# Register at https://dataspace.copernicus.eu/
CDSE_USERNAME=your-email@example.com
CDSE_PASSWORD=your-cdse-password

# ── NASA Earthdata (MODIS MAIAC AOD) ──────────────────────────
# Register at https://urs.earthdata.nasa.gov/
# Generate a Bearer token at https://urs.earthdata.nasa.gov/users/<username>/user_tokens
NASA_EARTHDATA_TOKEN=your-nasa-earthdata-bearer-token

# ── Upstash Redis (primary cache) ─────────────────────────────
# Create a free Redis database at https://upstash.com/
# Use the redis:// connection URL (not the REST URL)
REDIS_URL=redis://default:<password>@<host>.upstash.io:6379

# ── Optional: Upstash REST URL (alternative Redis client) ─────
# UPSTASH_REDIS_REST_URL=https://<host>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# ── Google Gemini (translations + localized insights) ─────────
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Mobile API (Expo) ─────────────────────────────────────────
# Local backend for mobile dev (restart Expo after changing):
# iOS Simulator:  EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Physical device: EXPO_PUBLIC_API_URL=http://<your-mac-lan-ip>:8000
#   (same IP shown in `npx expo start` as exp://<ip>:8081)
# EXPO_PUBLIC_API_URL=http://10.233.199.133:8000

# ── Paystack (mobile subscriptions) ───────────────────────────
# Create a project at https://paystack.com/, then Settings → API Keys.
# The PUBLIC key is safe to ship in the client bundle — it only allows
# Paystack Inline to start a checkout. Use pk_test_… for dev, pk_live_… for
# production. Enable USD on the Paystack dashboard before going live.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ── Supabase (mobile auth: sign-in / sign-up / session) ───────
# Create a project at https://supabase.com/, then Settings → API.
#   Project URL → EXPO_PUBLIC_SUPABASE_URL
#   anon public key (eyJ…) → EXPO_PUBLIC_SUPABASE_ANON_KEY
#     OR publishable key (sb_publishable_…) → EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Both formats are client-safe and equivalent; set whichever your project uses.
# Enable Email auth under Authentication → Providers.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Push alerts (episode + Did you know) ──────────────────────
# Set to 1 in production to run the daily scan / quiet-day fact push.
# Devices register via POST /api/v1/register-push-token (Expo).
ALERTS_ENABLED=0
# ALERTS_HOUR_UTC=6


