# cloudflare pages headers. static files (privacy.html, terms.html, icons) are
# served before any spa fallback, so those urls keep working.

# never cache the service worker or manifest, so updates roll out immediately.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# the html entry references the hashed bundle by name, so it must always be
# revalidated: a cached index.html would keep pointing at an old build even
# after a new one is deployed. this is what makes updates lag for returning
# users. the assets it points to are immutable and cached forever below.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# policy pages change without a new filename, so they must be revalidated
# rather than served from an edge or browser cache.
/version.json
  Cache-Control: no-cache

/privacy.html
  Cache-Control: no-cache
/terms.html
  Cache-Control: no-cache
/licenses.html
  Cache-Control: no-cache

# fingerprinted build assets can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# baseline security headers on every response.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self)
