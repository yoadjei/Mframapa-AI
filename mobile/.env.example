# Mframapa mobile — copy to `.env` and fill in.
#
# Expo only exposes variables prefixed EXPO_PUBLIC_ to the app bundle. That
# means every value here ends up readable inside the shipped app, so none of
# them may be a secret. Anon/publishable keys and DSNs are designed for this;
# a service-role key or an API secret must never appear in this file.
#
# app.config.js also reads the repo-root .env as a fallback, so a value set
# there works too. This file takes precedence.

# ── Required: the app is broken without these ────────────────────────────────

# Backend API. Leave as-is for production. For local backend use
# http://127.0.0.1:8000 — app.config.js rewrites loopback to your LAN IP so a
# physical phone can reach your machine.
EXPO_PUBLIC_API_URL=https://api.mframapa.live

# Map rendering. Without it the map tab falls back to a plain city list.
# Get one at https://account.mapbox.com/access-tokens/ (public token, pk.*)
EXPO_PUBLIC_MAPBOX_TOKEN=

# Sign in / sign up. Without these, auth screens fail and the app stays
# anonymous-only (which still works for air quality).
# Supabase dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional: features degrade gracefully without them ───────────────────────

# Crash reporting. Sentry → Project Settings → Client Keys (DSN).
# Native crash capture needs a dev/EAS build; Expo Go reports JS errors only.
EXPO_PUBLIC_SENTRY_DSN=

# Newer Supabase key format. Only set if your project issues a publishable key
# instead of an anon key; the app falls back to ANON_KEY above.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Payments for institutional plans. Individual use is free, so the app runs
# fine without this. Paystack → Settings → API Keys (public key, pk_*).
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
